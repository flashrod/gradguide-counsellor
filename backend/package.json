{
  "name": "gradguide-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:check": "tsx -e \"import('./src/db/utils.ts').then(async (m) => { await m.checkDatabaseConnection(); console.log('database ok'); const { closePool } = await import('./src/db/index.ts'); await closePool(); })\"",
    "ingest:demo": "tsx src/ingestion/demo.ts",
    "ingest": "tsx src/ingestion/cli.ts",
    "catalogue:report": "tsx src/ingestion/qualityReport.ts"
  },
  "dependencies": {
    "better-auth": "^1.3.9",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.44.5",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.2.12"
  }
}
