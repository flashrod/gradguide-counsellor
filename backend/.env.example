# Copy to .env for local development
PORT=4000

# Local PostgreSQL (see docker-compose.yml at the repo root)
DATABASE_URL=postgres://gradguide:gradguide@localhost:5432/gradguide

# Auth (better-auth, email+password). Generate a secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-min-32-chars-secret-for-local-dev
BETTER_AUTH_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Demo counsellor for local sign-in (seed-created, never committed as a real user)
DEMO_COUNSELLOR_EMAIL=demo@gradguide.local
DEMO_COUNSELLOR_PASSWORD=gradguide-dev-only
DEMO_COUNSELLOR_NAME=Demo Counsellor

# College Scorecard API (optional — demo ingestion works without it).
# Free key at https://api.data.gov/signup/ ; DEMO_KEY works for low volume.
# COLLEGESCOREDATA_API_URL=https://api.data.gov/ed/collegescorecard/v1
# COLLEGESCOREDATA_API_KEY=DEMO_KEY
